# Copy these into your host's environment variables (Render dashboard, etc.)
PAGE_ACCESS_TOKEN=PASTE_PAGE_ACCESS_TOKEN_HERE
VERIFY_TOKEN=pick-a-random-secret-string
OPENROUTER_API_KEY=PASTE_OPENROUTER_KEY_HERE

# Optional — change the free model (must end with :free). Alternatives:
#   nvidia/nemotron-3-ultra-550b-a55b:free
#   openai/gpt-oss-20b:free
#   poolside/laguna-s-2.1:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional — bot personality
SYSTEM_PROMPT=You are a friendly, helpful assistant chatting on Facebook Messenger. Keep replies concise and conversational.
